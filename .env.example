# ------------------------------------------------------------
# Copy this file to ".env" and edit the values. Nothing else to configure.
# ------------------------------------------------------------

# 1) DATABASE (required for shared/team data)
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Leave it empty to run in demo mode (data stays in your browser only).
DATABASE_URL=postgres://qa:qa_password@localhost:5432/qa

# Used only by docker compose to create the database container:
POSTGRES_USER=qa
POSTGRES_PASSWORD=qa_password
POSTGRES_DB=qa
POSTGRES_PORT=5432
APP_PORT=3000

# 2) AZURE DEVOPS (optional - powers the Project Health dashboard)
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-organisation
AZURE_DEVOPS_PAT=your-personal-access-token

# 3) AI TEST-CASE GENERATION (optional)
LOVABLE_API_KEY=
